[Unit]
Description=Janus — переворот текста между раскладками
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/janus daemon
Restart=on-failure
RestartSec=2
# Демону нужны X11-мост рабочего стола и уведомления D-Bus.
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=graphical-session.target
